<?xml version="1.0" encoding="utf-8"?>
<!-- La grande majorité des serveurs IPTV (Xtream, M3U) sont en HTTP simple :
     le trafic en clair doit être autorisé, sinon rien ne se charge. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
    <!-- TMDB (clé API dans l'URL) : HTTPS obligatoire, certificats système uniquement -->
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">themoviedb.org</domain>
        <domain includeSubdomains="true">tmdb.org</domain>
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </domain-config>
</network-security-config>
